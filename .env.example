# Copy to .env and fill in real values. Never commit .env.
POSTGRES_DB=bastion
POSTGRES_USER=bastion
POSTGRES_PASSWORD=change_me_strong_password

# Used by the API container
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=bastion;Username=bastion;Password=change_me_strong_password

# Email (MailHog in dev — no real credentials needed)
Email__Host=mailhog
Email__Port=1025
Email__From=bastion@localhost
